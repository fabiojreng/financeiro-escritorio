# Copie este arquivo para .env e preencha com valores reais.
# O arquivo .env nunca deve ser enviado para o repositorio.
# Nao use aspas nos valores: a aplicacao le este arquivo como .properties
# e as aspas passariam a fazer parte do valor (ex.: usuario "admin" com aspas).

# Banco de dados (usado pela aplicacao e pelo docker-compose)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=financeiro
DB_USERNAME=financeiro
DB_PASSWORD=troque-esta-senha

# Porta HTTP da aplicacao
SERVER_PORT=8080

# Primeiro administrador: so e criado quando nao existe nenhum usuario.
# Depois do primeiro acesso, remova estas duas linhas do .env.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_NAME=Administrador

# Use false durante o desenvolvimento para recarregar templates sem reiniciar
THYMELEAF_CACHE=true
