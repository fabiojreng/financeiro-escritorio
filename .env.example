# Copie este arquivo para .env e preencha com valores reais.
# O arquivo .env nunca deve ser enviado para o repositorio.
# Nao use aspas nos valores: a aplicacao le este arquivo como .properties
# e as aspas passariam a fazer parte do valor (ex.: usuario "admin" com aspas).

# Banco de dados (PostgreSQL instalado localmente; veja scripts/criar-banco-local.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=escritorio
DB_USERNAME=financeiro
DB_PASSWORD=troque-esta-senha
# prefer usa SSL quando o servidor oferece; bancos na nuvem (como o Neon) exigem require
DB_SSLMODE=prefer

# Banco separado usado pelos testes automatizados
DB_TEST_NAME=escritorio_test

# Banco separado usado pelo profile demo (dados ficticios)
DB_DEMO_NAME=escritorio_demo

# Porta HTTP da aplicacao
SERVER_PORT=8080

# Atras de um proxy com HTTPS (como o Render), use framework e true.
# Rodando direto na maquina, sem proxy, mantenha none e false.
FORWARD_HEADERS_STRATEGY=none
SESSION_COOKIE_SECURE=false

# Primeiro administrador: so e criado quando nao existe nenhum usuario.
# Depois do primeiro acesso, remova estas duas linhas do .env.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
APP_ADMIN_NAME=Administrador

# Use false durante o desenvolvimento para recarregar templates sem reiniciar
THYMELEAF_CACHE=true
